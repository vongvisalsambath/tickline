{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run site",
  "installCommand": "npm ci",
  "outputDirectory": "site",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tickline-gamma.vercel.app" }],
      "destination": "https://tickline-chart.vercel.app/:path*",
      "permanent": true
    }
  ]
}
